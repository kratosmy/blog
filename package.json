{
  "name": "kratos.blog",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check --minimumSeverity error && astro build && pnpm verify:artifact",
    "preview": "astro preview",
    "astro": "astro",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "format:check": "biome format .",
    "lint:check": "biome lint .",
    "translate:zh-en": "node scripts/translate-zh-to-en.mjs",
    "test": "vitest run",
    "verify:artifact": "node scripts/verify-build.mjs",
    "validate": "pnpm test && pnpm lint:check && pnpm format:check && pnpm build",
    "audit:dependencies": "pnpm audit --audit-level high"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/arvo": "^5.3.0",
    "@fontsource/google-sans-code": "^5.3.0",
    "astro": "^7.2.2",
    "astro-expressive-code": "^0.44.1",
    "markdown-it": "^15.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.8",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm format && git add ."
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.3",
      "nanoid@<3.3.18": "3.3.18"
    }
  }
}
