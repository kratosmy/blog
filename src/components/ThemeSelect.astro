<theme-select>
  <button type="button" class="text-control" aria-label="Toggle color theme">
    <span class="theme-label theme-label--light" aria-hidden="true">Dark</span>
    <span class="theme-label theme-label--dark" aria-hidden="true">Light</span>
  </button>
</theme-select>

<script>
  type Theme = 'auto' | 'dark' | 'light'

  const storageKey = 'theme'

  function parseTheme(theme: unknown): Theme {
    return theme === 'auto' || theme === 'dark' || theme === 'light'
      ? theme
      : 'auto'
  }

  function loadTheme(): Theme {
    return parseTheme(
      typeof localStorage !== 'undefined' && localStorage.getItem(storageKey),
    )
  }

  function storeTheme(theme: Theme): void {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(
        storageKey,
        theme === 'light' || theme === 'dark' ? theme : '',
      )
    }
  }

  function getPreferredColorScheme(): 'dark' | 'light' {
    return matchMedia('(prefers-color-scheme: light)').matches
      ? 'light'
      : 'dark'
  }

  function resolveTheme(theme: Theme): 'dark' | 'light' {
    return theme === 'auto' ? getPreferredColorScheme() : theme
  }

  function onThemeChange(theme: Theme): void {
    const resolvedTheme = resolveTheme(theme)
    document.documentElement.dataset['theme'] = resolvedTheme
    document.documentElement.classList.toggle('dark', resolvedTheme === 'dark')
    storeTheme(theme)
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') onThemeChange('auto')
  })

  if (!customElements.get('theme-select')) {
    customElements.define(
      'theme-select',
      class ThemeSelect extends HTMLElement {
        constructor() {
          super()
          onThemeChange(loadTheme())
          const button = this.querySelector('button')
          button?.addEventListener('click', () => {
            const theme = parseTheme(document.documentElement.dataset['theme'])
            const nextTheme = theme === 'dark' ? 'light' : 'dark'
            onThemeChange(nextTheme)
            button.setAttribute(
              'aria-label',
              `Switch to ${nextTheme === 'dark' ? 'light' : 'dark'} theme`,
            )
          })
        }
      },
    )
  }
</script>
