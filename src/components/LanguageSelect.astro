---
import { localeFromUrl, toggleUrl } from '@utils/locale'

const currentLang = localeFromUrl(Astro.url)
const toggleHref = toggleUrl(Astro.url)
const toggleTitle = currentLang === 'zh' ? 'Switch to English' : '切换到中文'
const shortLabel = currentLang === 'zh' ? 'EN' : '中'
---

<a href={toggleHref} class="text-control" title={toggleTitle}>
  <span aria-hidden="true">{shortLabel}</span>
  <span class="visually-hidden">{toggleTitle}</span>
</a>
