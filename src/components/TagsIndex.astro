---
import Layout from '@layouts/Layout.astro'
import { listTags, tagSlug } from '@utils/content'
import { useLocale } from '@utils/locale'
import type { SupportedLocale } from '../types'

interface Props {
  locale: SupportedLocale
}

const { locale } = Astro.props
const { t } = useLocale(Astro.url)
const tags = await listTags(locale)
const prefix = locale === 'en' ? '/en' : '/zh'
---

<Layout title={t('nav.tags')}>
  <main class="tags-page">
    <h1>{t('nav.tags')}</h1>
    {
      tags.length === 0 ? (
        <p class="empty-state">{t('message.no-posts')}</p>
      ) : (
        <ul class="tag-list">
          {tags.map((tag) => {
            const tagUrl = `${prefix}/tags/${tagSlug(tag)}/`
            return (
              <li>
                <a href={tagUrl}>{t(`tags.${tag}`)}</a>
              </li>
            )
          })}
        </ul>
      )
    }
  </main>
</Layout>
