---
import Layout from '@layouts/Layout.astro'
import { SITE_NAME } from '@utils/publishing'
import '../../styles/not-found.css'

export const prerender = true
---

<Layout
  title="404"
  header={false}
  navbar={false}
  noindex={true}
  languageAlternates={false}
>
  <main id="main-content" tabindex="-1" class="not-found">
    <a class="not-found__brand" href="/">{SITE_NAME}</a>
    <p class="not-found__code">404</p>
    <h1>
      <span lang="zh">页面未找到</span>
      <span lang="en">Page not found</span>
    </h1>
    <nav class="not-found__recovery" aria-label="Home / 首页">
      <a href="/" lang="zh">返回中文首页</a>
      <a href="/en/" lang="en">English home</a>
    </nav>
  </main>
</Layout>
