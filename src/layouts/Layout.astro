---
import criticalCss from '../styles/critical.css?raw'
import '../styles/index.css'
import { localeFromUrl, useLocale } from '@utils/locale'
import Header from './Header.astro'
import Navbar from './Navbar.astro'
import '@fontsource/arvo/400.css'
import '@fontsource/arvo/700.css'
import '@fontsource/google-sans-code'
import { SEO } from 'astro-seo'
import Footer from './Footer.astro'

const { t } = useLocale(Astro.url)
const htmlLang = localeFromUrl(Astro.url)

export const prerender = true

export interface Props {
  title: string | undefined
  navbar?: boolean
  description?: string
}

let { title, navbar, description } = Astro.props
if (navbar === undefined) navbar = true
if (!description) description = t('layout.description')
const fullTitle = `${title} - ${t('layout.title')}`
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <style is:inline set:html={criticalCss} />

    <script is:inline>
      ;(function () {
        try {
          const stored = localStorage.getItem('theme')
          const dark =
            stored === 'dark' ||
            ((!stored || stored === 'auto') &&
              window.matchMedia('(prefers-color-scheme: dark)').matches)
          if (dark) document.documentElement.classList.add('dark')
        } catch (_) {}
      })()
    </script>

    <title>{fullTitle}</title>
    <SEO
      title={fullTitle}
      description={description}
      openGraph={{
        basic: {
          title: fullTitle,
          type: 'website',
          image: 'https://avatars.githubusercontent.com/u/63009984?v=4',
        },
      }}
      twitter={{
        creator: '@kratosmy_',
      }}
    />
  </head>
  <body class="site-shell">
    <!--
      THESIS: John Wick is a bilingual personal archive, not a card-based content product.
      OWN-WORLD: Paper and ink surfaces, Arvo-led type, square edges, quiet rules, and a narrow editorial column.
      STORY: Readers meet the author, scan writing by year and date, then enter an uninterrupted reading view.
      FIRST VIEWPORT: A compact masthead and text navigation lead directly into the newest year; the archive link rule is the signature interaction.
      FORM: Restrained personal web journal, seventh grounded direction, seed 0f5372d0.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <Header />
    {navbar && <Navbar />}
    <slot />
    <Footer />
    <script defer>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {})
        })
      }
    </script>
  </body>
</html>
