---
import {
  activeSection,
  homeUrl,
  localeFromUrl,
  localePath,
  useLocale,
} from '@utils/locale'

const { url } = Astro
const { t } = useLocale(url)
const locale = localeFromUrl(url)
const section = activeSection(url)
const items = ['posts', 'tags'] as const
---

<nav class="site-nav" aria-label="Primary navigation">
  {
    items.map((item) => {
      const itemUrl = item === 'posts' ? homeUrl(locale) : localePath(locale, item)
      const isActive = section === item
      return (
        <a
          href={itemUrl}
          class="site-nav__link"
          class:list={isActive ? 'active' : ''}
          aria-current={isActive ? 'page' : undefined}
        >
          {t(`nav.${item}`)}
        </a>
      )
    })
  }
</nav>
