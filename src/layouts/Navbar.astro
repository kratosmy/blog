---
import { homeUrl, localeFromUrl, navUrl, useLocale } from '@utils/locale'

const { url } = Astro
const { t } = useLocale(url)
const locale = localeFromUrl(url)
const items = ['tags'] as const

function isPostsSection() {
  return (
    url.pathname === '/' ||
    url.pathname === '/zh/' ||
    url.pathname === '/en/' ||
    url.pathname.includes('/posts/')
  )
}
---

<nav class="site-nav" aria-label="Primary navigation">
  <a
    href={homeUrl(locale)}
    class="site-nav__link"
    class:list={isPostsSection() ? 'active' : ''}
    aria-current={isPostsSection() ? 'page' : undefined}
  >
    {t('nav.posts')}
  </a>
  {
    items.map((item) => {
      const itemUrl = navUrl(locale, item)
      const isActive = url.pathname.includes(`/${item}`)
      return (
        <a
          href={itemUrl}
          class="site-nav__link"
          class:list={isActive ? 'active' : ''}
          aria-current={isActive ? 'page' : undefined}
        >
          {t(`nav.${item}`)}
        </a>
      )
    })
  }
</nav>
