---
import { homeUrl, localeFromUrl, navUrl, useLocale } from '@utils/locale'

const { url } = Astro
const { t } = useLocale(url)
const locale = localeFromUrl(url)
const items = ['tags'] as const

function isPostsSection() {
  return (
    url.pathname === '/' ||
    url.pathname === '/zh/' ||
    url.pathname === '/en/' ||
    url.pathname.includes('/posts/') ||
    url.pathname.includes('/tags/')
  )
}
---

<nav>
  <a
    href={homeUrl(locale)}
    class="nav-link mr-4 animated hover:no-underline"
    class:list={isPostsSection() ? 'active' : ''}>{t('nav.posts')}</a
  >
  {
    items.map((item) => {
      const itemUrl = navUrl(locale, item)
      return (
        <a
          href={itemUrl}
          class="nav-link mr-4 animated hover:no-underline"
          class:list={url.pathname.includes(`/${item}`) ? 'active' : ''}
        >
          {t(`nav.${item}`)}
        </a>
      )
    })
  }
</nav>
