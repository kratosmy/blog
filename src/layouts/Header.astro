---
import { homeUrl, localeFromUrl, useLocale } from '@utils/locale'
import ThemeSelect from '../components/ThemeSelect.astro'
import LanguageSelect from '../components/LanguageSelect.astro'

const locale = localeFromUrl(Astro.url)
const home = homeUrl(locale)
const { t } = useLocale(Astro.url)
---

<header class="site-header">
  <div class="site-header__row">
    <a href={home} class="site-title">
      <span class="visually-hidden">Website home: </span>
      <h1>John Wick</h1>
    </a>
    <div class="site-controls" aria-label="Display preferences">
      <LanguageSelect />
      <ThemeSelect />
    </div>
  </div>
  <p class="site-description">{t('layout.description')}</p>
</header>
