---
/**
 * Post list module — sole loader for locale + optional tag filter.
 * Presentational chrome only; data comes from listPosts inside this module.
 */
import { displayTitle, listPosts, resolveTag } from '@utils/content'
import { formatArchiveDate } from '@utils/format'
import { homeUrl, useLocale } from '@utils/locale'
import type { SupportedLocale } from '../types'
import '../styles/archive.css'
import Layout from './Layout.astro'

interface Props {
  tag?: string
  locale?: SupportedLocale
}

const { t, locale: urlLocale } = useLocale(Astro.url)
const { tag: tagParam, locale: propsLocale } = Astro.props
const locale: SupportedLocale = propsLocale || urlLocale || 'zh'

const resolvedTag = tagParam
  ? ((await resolveTag(locale, tagParam)) ?? tagParam)
  : undefined

const { posts } = await listPosts(locale, { tag: resolvedTag })
const filterName = resolvedTag
const filterLabel = filterName ? t(`tags.${filterName}`) : undefined
const pageTitle = filterLabel
  ? `${t('nav.posts')} · ${filterLabel}`
  : t('nav.posts')
const archive = posts.reduce<Map<string, typeof posts>>((groups, post) => {
  const year = post.date.slice(0, 4)
  const group = groups.get(year) ?? []
  group.push(post)
  groups.set(year, group)
  return groups
}, new Map())
---

<Layout title={pageTitle}>
  <main id="main-content" tabindex="-1" class="archive-page">
    {
      filterLabel ? (
        <h1 class="archive-filter">“{filterLabel}”</h1>
      ) : (
        <h1 class="visually-hidden">{t('nav.posts')}</h1>
      )
    }
    {
      posts.length === 0 ? (
        <p class="empty-state">
          {t('message.no-posts')}
          <a class="empty-state__recovery" href={homeUrl(locale)}>
            {t('message.view_all_posts')}
          </a>
        </p>
      ) : (
        <article class="archive" aria-label={pageTitle}>
          {Array.from(archive).map(([year, yearPosts]) => (
            <section class="archive-year" aria-labelledby={`year-${year}`}>
              <h2 id={`year-${year}`}>{year}</h2>
              <ol>
                {yearPosts.map((post) => {
                  const title = displayTitle(post)
                  return (
                    <li class="archive-entry">
                      <time datetime={post.date}>
                        {formatArchiveDate(post.date, locale)}
                      </time>
                      <a href={post.url} class="archive-link">
                        {title}
                      </a>
                    </li>
                  )
                })}
              </ol>
            </section>
          ))}
        </article>
      )
    }
  </main>
</Layout>
